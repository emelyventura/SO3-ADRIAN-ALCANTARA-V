----------------------------------------------------------------------------------------------
sudo dnf install epel-release
sudo dnf install snort snort-rules-default
sudo apt install snort
sudo nano /etc/snort/rules/local.rules
alert icmp any any -> any any (msg:"ICMP ping detectado"; sid:1000001; rev:1;)
alert tcp any any -> any 21 (msg:"Tráfico FTP detectado"; sid:1000002; rev:1;)
alert tcp any any -> any 22 (msg:"Tráfico SSH detectado"; sid:1000003; rev:1;)
alert tcp any any -> any 80 (msg:"Tráfico HTTP detectado"; sid:1000004; rev:1;)
sudo snort -A console -c /etc/snort/snort.conf -i eth0
ping <IP_VM>
ftp <IP_VM>
ssh <IP_VM>
curl http://<IP_VM>/

